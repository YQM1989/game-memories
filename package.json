{
  "name": "game-memories",
  "version": "0.2.1",
  "type": "module",
  "description": "Collect Steam and Nintendo Switch game memories in Obsidian.",
  "bin": {
    "steam-experience-sync": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "gui": "node src/gui.mjs",
    "dry-run": "node src/index.mjs --dry-run",
    "dry-run:all": "node src/index.mjs --all --dry-run",
    "sync:all": "node src/index.mjs --all",
    "worker": "node src/index.mjs --worker",
    "worker:loop": "node src/index.mjs --worker-loop",
    "worker:dry-run": "node src/index.mjs --worker --dry-run",
    "worker:status": "node src/index.mjs --worker-status",
    "worker:stop": "node src/index.mjs --stop-worker",
    "worker:resume": "node src/index.mjs --clear-worker-stop",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop:prepare": "node scripts/prepare-macos-runtime.mjs",
    "desktop:verify-mac": "node scripts/verify-macos-bundle.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "switch:status": "node src/switch/index.mjs status",
    "switch:prepare": "node scripts/prepare-nxapi-client.mjs",
    "switch:preview": "node src/switch/index.mjs preview",
    "switch:import": "node src/switch/index.mjs sync",
    "test:ui": "vitest run",
    "check": "node --check src/index.mjs && node --check src/gui.mjs && npm run ui:build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
